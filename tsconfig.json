{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/services/import.service.ts",
    "src/services/backup.service.ts",
    "src/services/export.service.ts",
    "src/services/database.service.ts",
    "src/types/**/*.ts"
  ]
}
