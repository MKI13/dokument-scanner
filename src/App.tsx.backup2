import React, { useState } from 'react';
import { FileUploader } from './components/Upload/FileUploader';
import { OCRProgress } from './components/Upload/OCRProgress';
import { useSwipeable } from 'react-swipeable';
import { AllDocuments } from './pages/AllDocuments';
import { MonthView } from './pages/MonthView';
import { CustomerView } from './pages/CustomerView';
import { documentService } from './services/document.service';
import { Upload, FileText, Calendar, Users } from 'lucide-react';
import './App.css';

type View = 'upload' | 'all' | 'month' | 'customer';

function App() {
  const [currentView, setCurrentView] = useState<View>('upload');
  const [isProcessing, setIsProcessing] = useState(false);
  const [progress, setProgress] = useState({ status: '', progress: 0, message: '' });
  const [processingFiles, setProcessingFiles] = useState({ current: 0, total: 0 });
  
  const handleFilesSelected = async (files: File[]) => {
    setIsProcessing(true);
    setProcessingFiles({ current: 0, total: files.length });
    
    try {
      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        setProcessingFiles({ current: i + 1, total: files.length });
        
        await documentService.processAndSaveDocument(
          file,
          (prog) => {
  const [currentPage, setCurrentPage] = useState<"upload" | "documents" | "month" | "customer">("upload");

  const pages = ["upload", "documents", "month", "customer"] as const;
  
  const goToNextPage = () => {
    const currentIndex = pages.indexOf(currentPage);
    if (currentIndex < pages.length - 1) {
      setCurrentPage(pages[currentIndex + 1]);
    }
  };
  
  const goToPrevPage = () => {
    const currentIndex = pages.indexOf(currentPage);
    if (currentIndex > 0) {
      setCurrentPage(pages[currentIndex - 1]);
    }
  };
  
  const swipeHandlers = useSwipeable({
    onSwipedLeft: () => goToNextPage(),
    onSwipedRight: () => goToPrevPage(),
    trackMouse: true,
    preventScrollOnSwipe: true,
    delta: 50
  });
              ...prog,
              message: `Datei ${i + 1}/${files.length}: ${prog.message}`
            });
          },
          async (warning) => {
            return window.confirm(warning.message);
          },
          true // Progressive OCR aktiviert
        );
      }
      
      alert(`✅ ${files.length} Dokument(e) erfolgreich hochgeladen!`);
      setCurrentView('all');
      
    } catch (error) {
      console.error('Upload-Fehler:', error);
      
      if ((error as Error).message === 'Upload abgebrochen - Duplikat') {
        // Benutzer hat abgebrochen, kein Fehler anzeigen
      } else {
        alert('❌ Fehler beim Upload: ' + (error as Error).message);
      }
    } finally {
      setIsProcessing(false);
      setProgress({ status: '', progress: 0, message: '' });
      setProcessingFiles({ current: 0, total: 0 });
    }
  };
  
  return (
    <div className="app">
      <nav className="navbar">
        <div className="nav-brand">
          <FileText size={32} />
          <h1>Dokument Scanner</h1>
        </div>
        
        <div className="nav-menu">
          <button
            className={`nav-button ${currentView === 'upload' ? 'active' : ''}`}
            onClick={() => setCurrentView('upload')}
          >
            <Upload size={20} />
            <span>Upload</span>
          </button>
          
          <button
            className={`nav-button ${currentView === 'all' ? 'active' : ''}`}
            onClick={() => setCurrentView('all')}
          >
            <FileText size={20} />
            <span>Alle</span>
          </button>
          
          <button
            className={`nav-button ${currentView === 'month' ? 'active' : ''}`}
            onClick={() => setCurrentView('month')}
          >
            <Calendar size={20} />
            <span>Monat</span>
          </button>
          
          <button
            className={`nav-button ${currentView === 'customer' ? 'active' : ''}`}
            onClick={() => setCurrentView('customer')}
          >
            <Users size={20} />
            <span>Kunden</span>
          </button>
        </div>
      </nav>
      
      <main className="main-content" {...swipeHandlers}>
        {currentView === 'upload' && (
          <div className="upload-view">
            {isProcessing ? (
              <OCRProgress
                status={progress.status}
                progress={progress.progress}
                message={progress.message}
                current={processingFiles.current}
                total={processingFiles.total}
              />
            ) : (
              <FileUploader
                onFilesSelected={handleFilesSelected}
                multiple={true}
                maxFiles={50}
              />
            )}
          </div>
        )}
        
        {currentView === 'all' && <AllDocuments />}
        {currentView === 'month' && <MonthView />}
        {currentView === 'customer' && <CustomerView />}
      </main>
      </div>
    </div>
  );
}

export default App;
